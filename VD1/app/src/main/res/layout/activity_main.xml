<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center|top"
    tools:context=".MainActivity">

    <Button
        android:id="@+id/nuts01"
        android:text="NÚT SỐ 1"
        android:textSize="20sp"
        android:textColor="#958919"
        android:background="#5424A8"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp" />
    <Button
        android:id="@+id/nuts02"
        android:text="NÚT SỐ 2"
        android:textSize="20sp"
        android:textColor="#A27C0C"
        android:background="#5424A8"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp" />
    <Button
        android:id="@+id/nuts03"
        android:text="NÚT SỐ 3"
        android:textSize="20sp"
        android:textColor="#BF9412"
        android:background="#5424A8"
        android:layout_width="200dp"
        android:layout_height="60dp"
        android:layout_marginTop="20dp" />


</LinearLayout>